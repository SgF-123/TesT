{
  "name": "test-desktop",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test scripts/architecture.test.mjs scripts/session-experience.test.mjs scripts/session-fork.test.mjs scripts/turn-bookmarks.test.mjs scripts/turn-navigation.test.mjs scripts/preferences.test.mjs scripts/draft-store.test.mjs scripts/text-sanitize.test.mjs scripts/pi-kernel-runtime.test.mjs scripts/update-downloader.test.mjs",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "npm run build && electron . --dev",
    "electron:capture": "npm run build && electron . --dev --capture",
    "prepare:electron": "node scripts/prepare-electron.cjs",
    "dist": "npm run build && npm run prepare:electron && electron-builder --win",
    "dist:mac": "npm run build && npm run prepare:electron && electron-builder --mac"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "lucide": "^1.60.0",
    "lucide-react": "^1.59.0",
    "morphicons": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "description": "Windows desktop workspace for the Pi coding agent.",
  "author": "SgF-123",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SgF-123/TesT.git"
  },
  "homepage": "https://github.com/SgF-123/TesT#readme",
  "bugs": {
    "url": "https://github.com/SgF-123/TesT/issues"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "electron-updater": "^6.8.9",
    "ldrs": "^1.1.9",
    "node-pty": "^1.1.0",
    "qrcode-generator": "^2.0.4"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
